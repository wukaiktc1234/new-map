<view class="page-container">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  
  <view class="header-bar">
    <view class="header-left">
      <view class="back-btn" bindtap="goBack">
        <view class="back-icon"></view>
      </view>
    </view>
    <view class="header-center">
      <view class="header-title">绑定手机</view>
    </view>
    <view class="header-right"></view>
  </view>
  
  <view class="form-section">
    <view class="form-item">
      <view class="form-label">手机号</view>
      <input class="form-input" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" placeholder="请输入手机号" />
    </view>
    
    <view class="form-item">
      <view class="form-label">验证码</view>
      <input class="form-input code-input" type="number" maxlength="6" value="{{code}}" bindinput="onCodeInput" placeholder="请输入验证码" />
      <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendCode">
        <text>{{countdown > 0 ? countdown + 's' : '获取验证码'}}</text>
      </view>
    </view>
  </view>
  
  <view class="tips">
    <text>绑定手机后可使用手机号登录，并接收订单状态通知</text>
  </view>
  
  <view class="save-btn" bindtap="bindPhone">确认绑定</view>
</view>
