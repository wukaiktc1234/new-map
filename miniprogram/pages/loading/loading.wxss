@import "/styles/design-system.wxss";

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-warm) 0%, var(--bg-cream) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.simple-bowl {
  position: relative;
  width: 160rpx;
  height: 100rpx;
  margin-bottom: 60rpx;
}

.bowl-shape {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 140rpx;
  height: 70rpx;
  border: 6rpx solid #8B7355;
  border-top: none;
  border-radius: 0 0 70rpx 70rpx;
}

.bowl-rim {
  position: absolute;
  bottom: 64rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 152rpx;
  height: 12rpx;
  border: 6rpx solid #8B7355;
  border-bottom: none;
  border-radius: 12rpx 12rpx 0 0;
}

.steam {
  position: absolute;
  bottom: 90rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 24rpx;
}

.steam-line {
  width: 4rpx;
  height: 40rpx;
  background: #8B7355;
  border-radius: 2rpx;
  opacity: 0;
  animation: steam-rise 1.5s ease-out infinite;
}

.steam-line:nth-child(1) {
  animation-delay: 0s;
}

.steam-line:nth-child(2) {
  animation-delay: 0.3s;
}

.steam-line:nth-child(3) {
  animation-delay: 0.6s;
}

@keyframes steam-rise {
  0% {
    opacity: 0;
    transform: translateY(0) scaleY(0.5);
  }
  30% {
    opacity: 0.6;
  }
  100% {
    opacity: 0;
    transform: translateY(-50rpx) scaleY(1);
  }
}

.loading-dots {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.loading-dot {
  width: 20rpx;
  height: 20rpx;
  background: #8B7355;
  border-radius: 50%;
  animation: dot-bounce 1.2s ease-in-out infinite;
}

.loading-dot:nth-child(1) {
  animation-delay: 0s;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.15s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes dot-bounce {
  0%, 80%, 100% {
    transform: scale(0.8);
    opacity: 0.5;
  }
  40% {
    transform: scale(1.2);
    opacity: 1;
  }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.loading-dots-text {
  display: inline-block;
  animation: dots 1.5s steps(4, end) infinite;
}

@keyframes dots {
  0%, 20% { content: ''; }
  40% { content: '.'; }
  60% { content: '..'; }
  80%, 100% { content: '...'; }
}
