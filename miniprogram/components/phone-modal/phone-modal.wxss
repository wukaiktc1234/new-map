.wechat-btn text {
  font-size: 30rpx;
  color: var(--bg-card);
  font-weight: 500;
}

.divider {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: var(--border-light);
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.form-section {
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: var(--bg-warm);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.code-item {
  display: flex;
  gap: 16rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  width: 220rpx;
  height: 88rpx;
  background: var(--accent);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--bg-card);
  flex-shrink: 0;
}

.code-btn.disabled {
  background: var(--color-disabled);
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--accent-gold) 0%, var(--accent-gold-light) 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn text {
  font-size: 32rpx;
  color: var(--bg-card);
  font-weight: 500;
}
