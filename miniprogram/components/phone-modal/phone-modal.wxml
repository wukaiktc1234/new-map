<view class="phone-modal" wx:if="{{show}}" catchtouchmove="true">
  <view class="modal-mask" bindtap="onClose"></view>
  <view class="modal-content">
    <view class="modal-header">
      <view class="modal-title">验证手机号</view>
      <view class="modal-close" bindtap="onClose"></view>
    </view>
    
    <view class="modal-body">
      <view class="modal-desc">用于接收订单状态通知</view>
      
      <view class="wechat-login">
        <button class="wechat-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
          <view class="wechat-icon"></view>
          <text>微信一键验证</text>
        </button>
      </view>
      
      <view class="divider">
        <view class="divider-line"></view>
        <text class="divider-text">或</text>
        <view class="divider-line"></view>
      </view>
      
      <view class="form-section">
        <view class="form-item">
          <input 
            class="form-input" 
            type="number" 
            maxlength="11" 
            placeholder="请输入手机号" 
            value="{{phoneNumber}}"
            bindinput="onPhoneInput"
          />
        </view>
        
        <view class="form-item code-item">
          <input 
            class="form-input code-input" 
            type="number" 
            maxlength="6" 
            placeholder="请输入验证码" 
            value="{{code}}"
            bindinput="onCodeInput"
          />
          <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendCode">
            <text wx:if="{{countdown === 0}}">{{sending ? '发送中...' : '获取验证码'}}</text>
            <text wx:else>{{countdown}}s后重发</text>
          </view>
        </view>
      </view>
      
      <view class="confirm-btn" bindtap="onConfirm">
        <text>确认</text>
      </view>
    </view>
  </view>
</view>
