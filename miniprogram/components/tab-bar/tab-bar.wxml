    <view class="tab-icon home-icon"></view>
    <text class="tab-text">首页</text>
  </view>
  <view class="tab-item {{active === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1" data-url="/pages/menu-dinein/menu-dinein">
