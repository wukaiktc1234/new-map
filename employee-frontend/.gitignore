# 员工端（employee-frontend）.gitignore
# 基于 Vue + Vite + Capacitor 项目标准配置

# 依赖目录
node_modules/
.pnp
.pnp.js

# 构建产物
dist/
dist-ssr/

# 环境变量文件（含敏感信息）
.env
.env.local
.env.*.local

# 编辑器 / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript 缓存
*.tsbuildinfo

# Vite 缓存
.vite/

# 测试覆盖率
coverage/

# Android 原生工程（由 Capacitor 管理，建议单独版本控制或 gitignore）
# 如需纳入版本控制，可移除此条目并添加 android/.gitignore
# android/

# iOS 原生工程（同上）
# ios/

# 临时文件
*.tmp
*.temp
*.bak
*.swp
*~

# 本地开发临时数据
*.local
