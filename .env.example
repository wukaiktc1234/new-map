# Database Configuration (PostgreSQL 18)
DB_URL=jdbc:postgresql://localhost:5432/food_traceability
DB_USERNAME=postgres
DB_PASSWORD=123456

# Redis Configuration
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# RabbitMQ Configuration
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# JWT Configuration
JWT_SECRET=my-food-traceability-jwt-secret-key-2025-is-at-least-64-bytes-long-for-hs512-algorithm-secure-and-must-be-exactly-512-bits-or-more
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=2592000000

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password

# Server Configuration
SERVER_PORT=8081

# Logging Configuration
LOG_LEVEL=INFO
