<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foodtraceability.mapper.InventoryLogMapper">
    <select id="selectInventoryLogPage" resultType="com.foodtraceability.entity.InventoryLog">
        SELECT * FROM inventory_log
        ORDER BY create_time DESC
    </select>
    <select id="selectConsumptionStats" resultType="java.util.Map">
        SELECT SUM(change_quantity) AS total FROM inventory_log
    </select>
</mapper>