<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foodtraceability.mapper.InventoryWarningRuleMapper">
    
    <select id="selectWarningRulePage" resultType="com.foodtraceability.entity.InventoryWarningRule">
        SELECT * FROM inventory_warning_rule
        <where>
            <if test="ruleName != null and ruleName != ''">
                AND rule_name LIKE CONCAT('%', #{ruleName}, '%')
            </if>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="warningLevel != null">
                AND warning_level = #{warningLevel}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>
</mapper>
