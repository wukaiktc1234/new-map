<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foodtraceability.mapper.FoodMapper">

    <select id="selectFoodPage" resultType="com.foodtraceability.entity.Food">
        SELECT * FROM food
        WHERE deleted = 0
        <if test="foodName != null and foodName != ''">
            AND food_name LIKE CONCAT('%', #{foodName}, '%')
        </if>
        <if test="foodCategory != null and foodCategory != ''">
            AND food_category = #{foodCategory}
        </if>
        <if test="manufacturer != null and manufacturer != ''">
            AND manufacturer LIKE CONCAT('%', #{manufacturer}, '%')
        </if>
        <if test="foodStatus != null">
            AND food_status = #{foodStatus}
        </if>
        ORDER BY create_time DESC
    </select>

</mapper>
