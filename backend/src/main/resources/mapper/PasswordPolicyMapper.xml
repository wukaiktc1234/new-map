<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foodtraceability.mapper.PasswordPolicyMapper">

    <resultMap id="BaseResultMap" type="com.foodtraceability.entity.PasswordPolicy">
        <id column="policy_id" property="policyId"/>
        <result column="policy_name" property="policyName"/>
        <result column="min_length" property="minLength"/>
        <result column="max_length" property="maxLength"/>
        <result column="require_uppercase" property="requireUppercase"/>
        <result column="require_lowercase" property="requireLowercase"/>
        <result column="require_digit" property="requireDigit"/>
        <result column="require_special" property="requireSpecial"/>
        <result column="password_expiry_days" property="passwordExpiryDays"/>
        <result column="history_check_count" property="historyCheckCount"/>
        <result column="max_login_failures" property="maxLoginFailures"/>
        <result column="lock_duration_minutes" property="lockDurationMinutes"/>
        <result column="status" property="status"/>
        <result column="is_default" property="isDefault"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="version" property="version"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectDefaultPolicy" resultMap="BaseResultMap">
        SELECT * FROM password_policies
        WHERE is_default = TRUE AND deleted = 0
        LIMIT 1
    </select>

    <select id="selectByPolicyName" resultMap="BaseResultMap">
        SELECT * FROM password_policies
        WHERE policy_name = #{policyName} AND deleted = 0
        LIMIT 1
    </select>

</mapper>
