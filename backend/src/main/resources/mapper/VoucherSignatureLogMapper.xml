<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foodtraceability.mapper.VoucherSignatureLogMapper">

    <select id="selectByVoucherId" resultType="com.foodtraceability.entity.VoucherSignatureLog">
        SELECT * FROM voucher_signature_log
        WHERE voucher_id = #{voucherId}
        AND deleted = 0
        ORDER BY create_time DESC
    </select>

</mapper>
