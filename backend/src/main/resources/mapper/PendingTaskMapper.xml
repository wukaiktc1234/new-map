<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foodtraceability.mapper.PendingTaskMapper">

    <!--
        注意: 已移除冗余的resultMap定义。
        原因: MyBatis-Plus已开启map-underscore-to-camel-case: true，
        字段名自动映射（snake_case → camelCase），无需手动定义resultMap。
        仅保留resultMap用于需要特殊映射的场景（当前不存在）。
    -->

    <!-- 分页查询通用SQL片段 -->
    <sql id="selectTaskColumns">
        task_id, task_type, title, description, priority,
        assignee_id, assignee_role, source_type, source_id,
        redirect_url, status, due_date, completed_at, created_by,
        version, deleted, create_time, update_time
    </sql>

    <!-- 查询条件片段 -->
    <sql id="queryCondition">
        <where>
            <if test="query.taskType != null and query.taskType != ''">
                AND task_type = #{query.taskType}
            </if>
            <if test="query.status != null and query.status != ''">
                AND status = #{query.status}
            </if>
            <if test="query.priority != null">
                AND priority = #{query.priority}
            </if>
            <if test="query.assigneeId != null and query.assigneeId != ''">
                AND assignee_id = #{query.assigneeId}
            </if>
            <if test="query.sourceType != null and query.sourceType != ''">
                AND source_type = #{query.sourceType}
            </if>
            <if test="query.startDate != null">
                AND due_date &gt;= #{query.startDate}
            </if>
            <if test="query.endDate != null">
                AND due_date &lt;= #{query.endDate}
            </if>
            <if test="query.keyword != null and query.keyword != ''">
                AND (title LIKE CONCAT('%', #{query.keyword}, '%')
                     OR description LIKE CONCAT('%', #{query.keyword}, '%'))
            </if>
        </where>
    </sql>

    <!--
        分页查询待办任务
        支持多条件组合筛选，按优先级降序、截止日期升序、创建时间降序排序
    -->
    <select id="selectTaskPage" resultType="com.foodtraceability.entity.PendingTask">
        SELECT <include refid="selectTaskColumns"/>
        FROM pending_tasks
        <include refid="queryCondition"/>
        ORDER BY
            CASE priority
                WHEN 4 THEN 1   -- 紧急优先
                WHEN 3 THEN 2   -- 高优先
                WHEN 2 THEN 3   -- 中优先
                WHEN 1 THEN 4   -- 低优先
                ELSE 5
            END,
            due_date ASC,
            create_time DESC
    </select>

    <!--
        根据被指派人ID查询任务列表
        返回该用户的所有任务（排除已完成和已取消），按优先级和截止时间排序
    -->
    <select id="selectByAssigneeId" resultType="com.foodtraceability.entity.PendingTask">
        SELECT <include refid="selectTaskColumns"/>
        FROM pending_tasks
        WHERE assignee_id = #{assigneeId}
          AND status IN ('pending', 'in_progress')
        ORDER BY
            CASE priority
                WHEN 4 THEN 1
                WHEN 3 THEN 2
                WHEN 2 THEN 3
                WHEN 1 THEN 4
                ELSE 5
            END,
            due_date ASC,
            create_time DESC
    </select>

    <!--
        统计指定用户的未读任务数量
        未读任务：状态为pending或in_progress的任务
    -->
    <select id="countUnreadTasks" resultType="int">
        SELECT COUNT(*)
        FROM pending_tasks
        WHERE assignee_id = #{assigneeId}
          AND status IN ('pending', 'in_progress')
    </select>

</mapper>
