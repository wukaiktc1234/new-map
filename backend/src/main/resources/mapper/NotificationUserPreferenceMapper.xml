<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foodtraceability.mapper.NotificationUserPreferenceMapper">

    <resultMap id="BaseResultMap" type="com.foodtraceability.entity.NotificationUserPreference">
        <id column="preference_id" property="preferenceId"/>
        <result column="user_id" property="userId"/>
        <result column="notification_type" property="notificationType"/>
        <result column="channel" property="channel"/>
        <result column="is_enabled" property="isEnabled"/>
        <result column="frequency" property="frequency"/>
        <result column="version" property="version"/>
        <result column="deleted" property="deleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM notification_user_preference
        WHERE deleted = 0 AND user_id = #{userId}
        ORDER BY notification_type, channel
    </select>

    <select id="selectByUserAndTypeAndChannel" resultMap="BaseResultMap">
        SELECT * FROM notification_user_preference
        WHERE deleted = 0 AND user_id = #{userId}
          AND notification_type = #{notificationType}
          AND channel = #{channel}
        LIMIT 1
    </select>

</mapper>
