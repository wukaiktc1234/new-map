<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foodtraceability.mapper.AlertEntityMapper">

    <resultMap id="BaseResultMap" type="com.foodtraceability.entity.AlertEntity">
        <id column="alert_id" property="alertId"/>
        <result column="alert_name" property="name"/>
        <result column="description" property="description"/>
        <result column="severity" property="severity"/>
        <result column="alert_status" property="status"/>
        <result column="alert_value" property="value"/>
        <result column="threshold_value" property="threshold"/>
        <result column="source" property="source"/>
        <result column="source_type" property="sourceType"/>
        <result column="source_id" property="sourceId"/>
        <result column="alert_time" property="alertTime"/>
        <result column="resolve_time" property="resolveTime"/>
        <result column="acknowledge_time" property="acknowledgeTime"/>
        <result column="acknowledged_by" property="acknowledgedBy"/>
        <result column="resolved_by" property="resolvedBy"/>
        <result column="resolve_description" property="resolveDescription"/>
        <result column="assigned_to" property="assignedTo"/>
        <result column="version" property="version"/>
        <result column="deleted" property="deleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectAlertPage" resultMap="BaseResultMap">
        SELECT * FROM alert WHERE deleted = 0
        <if test="severity != null and severity != ''">
            AND severity = #{severity}
        </if>
        <if test="status != null and status != ''">
            AND alert_status = #{status}
        </if>
        <if test="source != null and source != ''">
            AND source LIKE CONCAT('%', #{source}, '%')
        </if>
        ORDER BY alert_time DESC
    </select>

    <select id="selectActiveAlerts" resultMap="BaseResultMap">
        SELECT * FROM alert WHERE deleted = 0 AND alert_status = 'ACTIVE'
        ORDER BY alert_time DESC
    </select>

    <select id="countBySeverity" resultType="long">
        SELECT COUNT(*) FROM alert WHERE deleted = 0 AND severity = #{severity}
    </select>

    <select id="countByStatus" resultType="long">
        SELECT COUNT(*) FROM alert WHERE deleted = 0 AND alert_status = #{status}
    </select>

</mapper>
