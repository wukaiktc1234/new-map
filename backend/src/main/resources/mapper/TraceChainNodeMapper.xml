<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foodtraceability.mapper.TraceChainNodeMapper">

    <!-- 追溯链节点结果映射 -->
    <resultMap id="nodeResultMap" type="com.foodtraceability.entity.TraceChainNode">
        <id column="node_id" property="nodeId"/>
        <result column="trace_code_id" property="traceCodeId"/>
        <result column="node_sequence" property="nodeSequence"/>
        <result column="node_type" property="nodeType"/>
        <result column="event_time" property="eventTime"/>
        <result column="location" property="location"/>
        <result column="operator_id" property="operatorId"/>
        <result column="operator_name" property="operatorName"/>
        <result column="detail_json" property="detailJson" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="attachment_url" property="attachmentUrl"/>
        <result column="geo_location" property="geoLocation"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- 根据追溯码ID查询所有节点（按序号排序） -->
    <select id="selectByTraceCodeIdOrderBySequence" resultMap="nodeResultMap">
        SELECT * FROM trace_chain_nodes
        WHERE trace_code_id = #{traceCodeId}
        ORDER BY node_sequence ASC
    </select>

    <!-- 查询追溯链的最大序号 -->
    <select id="selectMaxSequenceByTraceCodeId" resultType="java.lang.Integer">
        SELECT COALESCE(MAX(node_sequence), 0) FROM trace_chain_nodes
        WHERE trace_code_id = #{traceCodeId}
    </select>

    <!-- 根据节点类型查询 -->
    <select id="selectByNodeType" resultMap="nodeResultMap">
        SELECT * FROM trace_chain_nodes
        WHERE node_type = #{nodeType}
        ORDER BY event_time DESC
    </select>

</mapper>
