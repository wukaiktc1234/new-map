# ============================================================
# 食品溯源系统 - 后端环境变量配置示例
# ============================================================
# 用法：
#   1. 复制本文件为 .env 并填入实际值
#   2. 通过 Docker/K8s/systemd 等方式注入环境变量
#   3. 生产环境（application-prod.yml）中所有密钥均无默认值，必须强制注入
#
# 安全原则：
#   - 所有密钥/密码禁止硬编码在代码或配置文件中
#   - 生产环境密钥通过 Vault/KMS 等密钥管理系统管理
#   - 开发环境可在 application.yml/application-pg.yml 中保留 dev-only 默认值
# ============================================================

# ============================================================
# 数据库配置（PostgreSQL 18）
# ============================================================
PG_HOST=localhost
PG_PORT=5432
PG_DB_NAME=food_traceability
PG_USERNAME=postgres
# 生产环境必须替换为强密码（至少16位，包含大小写字母/数字/特殊字符）
PG_PASSWORD=change-me-to-a-strong-password-in-production

# ============================================================
# Redis 配置（生产环境启用）
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ============================================================
# RabbitMQ 配置（生产环境启用）
# ============================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/

# ============================================================
# JWT 配置
# ============================================================
# JWT 密钥：HS512 算法要求至少 64 字节
# 生成命令：openssl rand -base64 64
# 生产环境必须替换为强随机密钥
JWT_SECRET=change-me-to-a-random-string-at-least-64-bytes-long-for-hs512-algorithm
# Access Token 有效期（毫秒），默认 8 小时
JWT_ACCESS_TOKEN_EXPIRATION=28800000
# Refresh Token 有效期（毫秒），默认 7 天
JWT_REFRESH_TOKEN_EXPIRATION=604800000
# 刷新窗口（毫秒），默认 1 小时
JWT_REFRESH_WINDOW=3600000

# ============================================================
# 加密密钥配置
# ============================================================
# 应用 AES 加密密钥（AesEncryptionUtil 使用，至少 16 字符，建议 32+ 字符）
# 生成命令：openssl rand -base64 32
# 注意：不能包含 default/change/placeholder/test/password/secret（弱密钥校验）
APP_ENCRYPTION_KEY=change-me-to-a-strong-aes-key-32chars

# AES 工具类密钥（AESUtil 使用，至少 16 字符，建议 32+ 字符）
# 生成命令：openssl rand -base64 32
# 注意：不能包含 default/change/placeholder/test/password/secret（弱密钥校验）
AES_SECRET_KEY=change-me-to-another-strong-aes-key-32chars

# 系统配置加密密钥（SystemConfigServiceImpl 使用，加密数据库中的敏感配置）
# 生成命令：openssl rand -base64 32
CONFIG_ENCRYPT_KEY=change-me-to-a-strong-config-encrypt-key-32chars

# Jasypt 配置加密密码（用于加密 application.yml 中的敏感属性）
JASYPT_ENCRYPTOR_PASSWORD=

# ============================================================
# 邮件服务配置（SMTP）
# ============================================================
# SMTP 服务器地址（中国大陆请使用国内 SMTP 服务，smtp.gmail.com 无法直连）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# 兼容旧变量名（MAIL_* 在 application.yml 中使用）
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ============================================================
# 第三方服务配置
# ============================================================
# 百度智能云 TTS（语音播报，密钥由后端持有，禁止前端传入）
BAIDU_TTS_API_KEY=
BAIDU_TTS_API_SECRET=

# 智谱 AI（GLM-4V OCR 视觉模型）
ZHIPU_AI_API_KEY=
OCR_ZHIPU_API_KEY=
OCR_ZHIPU_MODEL=glm-4v-flash

# 税务平台发票验真 API
VERIFY_TAX_PLATFORM_ENABLED=true
VERIFY_TAX_PLATFORM_URL=https://inv-veri.chinatax.gov.cn
VERIFY_TAX_PLATFORM_APP_KEY=
VERIFY_TAX_PLATFORM_APP_SECRET=
VERIFY_TAX_PLATFORM_TIMEOUT=30000

# 企业微信集成
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=
WECOM_CALLBACK_URL=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# ============================================================
# SSL/HTTPS 配置
# ============================================================
SSL_ENABLED=false
SSL_KEYSTORE_PATH=
SSL_KEYSTORE_PASSWORD=
SSL_KEYSTORE_TYPE=PKCS12
SSL_KEY_ALIAS=

# ============================================================
# OCR 服务配置（PaddleOCR）
# ============================================================
OCR_PADDLE_BASE_URL=http://localhost:8110
OCR_PADDLE_TIMEOUT=120000
OCR_PADDLE_MAX_FILE_SIZE=52428800

# ============================================================
# 数据备份配置
# ============================================================
BACKUP_STORAGE_PATH=./backups
BACKUP_PG_BIN_PATH=
BACKUP_PG_DUMP_TIMEOUT=1800000
BACKUP_PG_RESTORE_TIMEOUT=3600000
BACKUP_AUTO_ENABLED=false
BACKUP_RETENTION_COUNT=10
BACKUP_MAX_AGE_HOURS=24

# ============================================================
# 链路追踪配置
# ============================================================
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# ============================================================
# 文件上传配置
# ============================================================
FILE_UPLOAD_PATH=./uploads/voucher
FILE_UPLOAD_MAX_SIZE=10485760

# ============================================================
# OpenAPI 文档配置
# ============================================================
API_SERVER_URL=http://localhost:8081
API_SERVER_URL_PROD=https://api.foodtraceability.com

# ============================================================
# 日志配置
# ============================================================
LOG_FILE_PATH=./logs/food-traceability.log
LOG_MAX_SIZE=100MB
LOG_MAX_HISTORY=30
