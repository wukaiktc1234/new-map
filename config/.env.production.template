# ============================================================
# 食品溯源系统 - 生产环境密钥配置模板
# ============================================================
# 
# 使用说明：
# 1. 复制此文件为 .env.production
# 2. 替换所有 <GENERATE_SECRET> 为实际生成的密钥
# 3. 替换所有 <YOUR_VALUE> 为实际配置值
# 4. 确保 .env.production 不被提交到版本控制
# 
# 密钥生成命令：
# - 64字符随机密钥: openssl rand -base64 48 | tr -d '\n'
# - 32字符随机密钥: openssl rand -hex 16
# - UUID: uuidgen
# ============================================================

# ==================== 核心安全配置 ====================

# JWT签名密钥（必须64字符以上，用于HS512签名）
# 生成命令: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=<GENERATE_SECRET_64_CHARS>

# JWT刷新令牌密钥（可选，不设置则使用JWT_SECRET）
JWT_REFRESH_SECRET=<GENERATE_SECRET_64_CHARS>

# JWT配置
JWT_ISSUER=food-traceability-prod
JWT_ACCESS_TOKEN_EXPIRATION=7200000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ==================== 数据库配置 ====================

# PostgreSQL 数据库
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_traceability
DB_USER=foodtrace_app
DB_PASSWORD=<GENERATE_STRONG_PASSWORD>

# 数据库连接池
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5

# ==================== Redis配置 ====================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<GENERATE_REDIS_PASSWORD>
REDIS_DATABASE=0

# ==================== 加密配置 ====================

# AES-256 数据加密密钥（用于敏感字段加密）
# 生成命令: openssl rand -base64 32
ENCRYPTION_KEY=<GENERATE_SECRET_32_CHARS>

# ==================== 验证码配置 ====================

# 验证码签名密钥
CAPTCHA_SECRET=<GENERATE_SECRET_32_CHARS>

# ==================== 邮件服务配置 ====================

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=<YOUR_SMTP_PASSWORD>
MAIL_FROM=noreply@yourdomain.com

# ==================== 文件存储配置 ====================

# 文件上传目录
FILE_UPLOAD_DIR=/data/uploads

# 最大文件大小
FILE_MAX_SIZE=10MB

# ==================== 监控配置 ====================

# Prometheus 监控端点
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus,metrics

# Actuator 安全配置
MANAGEMENT_SERVER_PORT=8081

# ==================== 日志配置 ====================

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=WARN

# 日志文件路径
LOG_FILE_PATH=/var/log/food-traceability

# ==================== 安全配置 ====================

# 允许的登录失败次数
SECURITY_MAX_LOGIN_ATTEMPTS=5

# 账户锁定时间（分钟）
SECURITY_LOCK_DURATION=30

# 密码最小长度
SECURITY_PASSWORD_MIN_LENGTH=8

# ==================== CORS配置 ====================

# 允许的前端域名（多个用逗号分隔）
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==================== 限流配置 ====================

# IP限流：每分钟请求数
RATE_LIMIT_IP_PER_MINUTE=30

# 用户限流：每分钟请求数
RATE_LIMIT_USER_PER_MINUTE=60

# 登录限流：每分钟请求数
RATE_LIMIT_LOGIN_PER_MINUTE=5

# ==================== 会话配置 ====================

# 会话超时时间（秒）
SESSION_TIMEOUT=7200

# 最大并发会话数
SESSION_MAX_CONCURRENT=5

# ==================== 备份配置 ====================

# 数据库备份目录
BACKUP_DIR=/backup/database

# 备份保留天数
BACKUP_RETENTION_DAYS=30

# ==================== 第三方服务配置 ====================

# OCR服务（如使用）
OCR_SERVICE_URL=http://localhost:5000
OCR_SERVICE_KEY=<YOUR_OCR_KEY>

# 支付服务（如使用）
PAYMENT_MERCHANT_ID=<YOUR_MERCHANT_ID>
PAYMENT_SECRET_KEY=<YOUR_PAYMENT_KEY>

# ==================== 告警配置 ====================

# 告警邮件接收者
ALERT_EMAIL_RECIPIENTS=ops@yourdomain.com,security@yourdomain.com

# 钉钉/企业微信告警Webhook
ALERT_WEBHOOK_URL=<YOUR_WEBHOOK_URL>

# ============================================================
# 部署检查清单
# ============================================================
# 
# [ ] 所有 <GENERATE_*> 已替换为实际密钥
# [ ] 所有 <YOUR_*> 已替换为实际配置值
# [ ] 数据库用户权限已最小化
# [ ] Redis已设置密码
# [ ] 文件上传目录已创建并设置权限
# [ ] 日志目录已创建并设置权限
# [ ] SSL证书已配置
# [ ] 防火墙规则已配置
# [ ] 监控告警已配置
# [ ] 备份脚本已测试
# 
# ============================================================
