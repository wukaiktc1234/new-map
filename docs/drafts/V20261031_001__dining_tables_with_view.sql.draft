-- V20261031_001__dining_tables_with_view.sql   [DRAFT - NOT EXECUTED]
--
-- WHY (Lead/Owner 2026-10-30):
--   public.dining_table is a VIEW (NOT a base table). Its base table public.dining_tables
--   is created at STARTUP by config/DatabaseFixConfig (a Java DDL runner), which is now
--   disabled by @ConditionalOnProperty. Consequences:
--     1) A brand-new environment has NO dining_tables -> the view cannot be created ->
--        the whole table/dining feature is unavailable.
--     2) Writes through the view fail at runtime:
--        PSQLException: cannot insert into column "area" of view "dining_table" (SQLSTATE 0A000)
--        because the view has expression columns (area_id::text, CASE status ..., NULL::timestamp)
--        and is therefore NOT auto-updatable.
--
-- SCOPE OF THIS MIGRATION (step 1 of 3; see ADR):
--   Step 1 (this file): create the BASE TABLE + the VIEW via Flyway -> new env deployable.
--   Step 2 (later): point entity DiningTable at dining_tables (target solution B).
--   Step 3 (later): align frontend field semantics (status int vs text).
--
-- STATUS: DRAFT. Must be validated twice with Flyway on ft_gate BEFORE entering the main DB.
--   Tonight already had two production outages from migrations; no night-time migration upload.
--
-- Pure ASCII (Owner red line). Asserts existence only, never a global column count.

-- 1) base table (16 columns, taken from production information_schema.columns)
CREATE TABLE IF NOT EXISTS dining_tables (
  table_id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  table_code character varying(64) NOT NULL,
  table_name character varying(64),
  area_id bigint,
  table_type integer,
  seats_count integer,
  min_people integer,
  max_people integer,
  status integer,
  current_order_id character varying(64),
  qr_code character varying(500),
  sort_order integer,
  create_time timestamp without time zone DEFAULT now(),
  update_time timestamp without time zone DEFAULT now(),
  deleted integer DEFAULT 0,
  store_id bigint
);

-- 2) view (definition reproduced verbatim from pg_get_viewdef on production)
CREATE OR REPLACE VIEW dining_table AS
SELECT d.table_id AS id,
       d.table_code AS table_number,
       d.table_name,
       d.seats_count AS capacity,
       d.area_id::text AS area,
       CASE d.status WHEN 1 THEN 'available'::text
                    WHEN 2 THEN 'occupied'::text
                    ELSE d.status::text END AS status,
       d.qr_code,
       d.current_order_id::text AS current_order_id,
       d.min_people AS guest_count,
       NULL::timestamp without time zone AS seated_at,
       d.create_time AS created_at,
       d.update_time AS updated_at
  FROM dining_tables d
 WHERE d.deleted = 0;

-- 3) assertions (existence only)
DO $$
DECLARE
    v_cnt int;
    missing text;
BEGIN
    SELECT count(*) INTO v_cnt FROM information_schema.tables
     WHERE table_schema = 'public' AND table_name = 'dining_tables' AND table_type = 'BASE TABLE';
    IF v_cnt <> 1 THEN
        RAISE EXCEPTION 'assert failed: dining_tables base table missing';
    END IF;

    SELECT count(*) INTO v_cnt FROM information_schema.tables
     WHERE table_schema = 'public' AND table_name = 'dining_table' AND table_type = 'VIEW';
    IF v_cnt <> 1 THEN
        RAISE EXCEPTION 'assert failed: dining_table view missing';
    END IF;

    SELECT string_agg(c, ', ') INTO missing
      FROM unnest(ARRAY[
            'table_id','table_code','table_name','area_id','table_type','seats_count',
            'min_people','max_people','status','current_order_id','qr_code','sort_order',
            'create_time','update_time','deleted','store_id']) AS c
     WHERE NOT EXISTS (SELECT 1 FROM information_schema.columns
                        WHERE table_schema = 'public' AND table_name = 'dining_tables'
                          AND column_name = c);
    IF missing IS NOT NULL THEN
        RAISE EXCEPTION 'assert failed: dining_tables missing columns %', missing;
    END IF;

    SELECT string_agg(c, ', ') INTO missing
      FROM unnest(ARRAY[
            'id','table_number','table_name','capacity','area','status','qr_code',
            'current_order_id','guest_count','seated_at','created_at','updated_at']) AS c
     WHERE NOT EXISTS (SELECT 1 FROM information_schema.columns
                        WHERE table_schema = 'public' AND table_name = 'dining_table'
                          AND column_name = c);
    IF missing IS NOT NULL THEN
        RAISE EXCEPTION 'assert failed: dining_table view missing columns %', missing;
    END IF;

    RAISE NOTICE 'V20261031_001 OK: dining_tables (base table, 16 cols) + dining_table (view, 12 cols) present';
END $$;
