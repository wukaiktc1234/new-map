# ==================== 环境变量配置 ====================
# 
# 本文件用于配置不同环境下的参数
# 复制本文件为 .env.local 并修改相应值
# 
# 注意：.env.local 文件已加入 .gitignore，不会提交到代码库
#

# ==================== 开发环境（默认） ====================

# 应用标题
VITE_APP_TITLE=食品溯源系统

# API基础路径（开发环境使用代理）
VITE_API_BASE_URL=/api

# ==================== 内网H5表单二维码配置（安全隔离） ====================
#
# ⚠️ 重要：H5表单使用独立端口 3003，与管理端 3002 完全隔离！
#
# 安全架构：
#   - 管理端（Vue SPA）：端口 3002（需要登录认证）
#   - H5表单（静态页面）：端口 3003（公开访问，无管理功能）
#
# 为什么需要隔离？
#   ✅ 防止求职者访问管理后台
#   ✅ 即使知道IP也无法进入系统
#   ✅ H5表单仅用于收集应聘信息，无敏感数据
#
# 格式：http://内网IP地址:3003
# 示例：
#   - http://192.168.1.100:3003    （常见内网IP）
#   - http://10.0.0.5:3003         （另一种内网段）
#
# 📱 求职者扫码时，手机会访问这个地址 + /recruit/apply.html?job=岗位ID
#    所以必须是求职者手机能访问到的地址！
#
# 🔧 如何获取您的内网IP：
#   Windows: 打开CMD → 输入 ipconfig → 找到"IPv4 地址"
#   Mac: 打开终端 → 输入 ifconfig | grep "inet "
#   Linux: 打开终端 → 输入 ip addr show
#
# 🚀 启动方式：
#   方式1（推荐）：npm run dev:all  （同时启动管理端+H5服务器）
#   方式2：分别启动
#     - 终端1：npm run dev          （启动管理端 :3002）
#     - 终端2：npm run h5-server    （启动H5表单 :3003）
#
# ⚠️ 如果不配置此项，开发环境默认使用 localhost:3003

# VITE_INTERNAL_BASE_URL=http://192.168.1.100:3003

# ==================== 其他可选配置 ====================

# 是否启用调试模式
VITE_DEBUG=false

# 是否显示性能监控面板
VITE_PERFORMANCE_MONITOR=false
