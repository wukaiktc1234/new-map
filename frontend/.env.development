# ==================== 开发环境配置 ====================

# 应用标题
VITE_APP_TITLE=食品溯源系统

# API基础路径（开发环境使用代理）
VITE_API_BASE_URL=/api

# ==================== 内网H5表单配置（安全隔离） ====================
#
# ⚠️ 重要：H5表单使用独立端口 3003，与管理端 3002 隔离！
#
# 架构说明：
#   - 管理端（Vue SPA）：http://localhost:3002 或 http://内网IP:3002
#   - H5表单（静态页面）：http://localhost:3003 或 http://内网IP:3003
#
# 安全优势：
#   ✅ 求职者无法访问管理后台（不同端口）
#   ✅ 即使知道IP也无法进入系统
#   ✅ H5表单无登录功能，仅用于收集信息
#
# 📱 二维码地址格式：
#   http://内网IP:3003/recruit/apply.html?job=岗位ID
#

VITE_INTERNAL_BASE_URL=http://192.168.0.106:3003

# 是否启用调试模式
VITE_DEBUG=false

# ==================== Mock 数据与真实数据库分离 ====================
#
# 默认 false：使用真实后端 API（H2/PostgreSQL），不加载任何 mock 数据
# 设为 true 时：自动启用 mock 模式（后端不可用时回退到 mock 数据）
#
# 设计原则：
#   - 开发环境默认走真实数据库（H2 PostgreSQL 兼容模式）
#   - mock 数据作为「显式 opt-in」功能，仅在后端不可用时手动启用
#   - 生产环境构建时此变量被忽略（生产永不启用 mock 模式）
#
VITE_USE_MOCK=false

